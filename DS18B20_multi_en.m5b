{"category":"DS18B20","color":"#333333","blocks":["__DS18B20_init","__DS18B20_scan","__DS18B20_convert_temp","__DS18B20_read"],"jscode":"// Block __DS18B20_init\nvar __DS18B20_init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"init\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"dq_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"dq_pin\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"vcc_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"vcc_pin\"\n        }\n    ],\n    \"colour\": \"#333333\"\n};\n\nwindow['Blockly'].Blocks['__DS18B20_init'] = {\n    init: function() {\n        this.jsonInit(__DS18B20_init_json);\n    }\n};\n\nwindow['Blockly'].Python['__DS18B20_init'] = function(block) {\n    var dq_pin = block.getFieldValue('dq_pin');\nvar vcc_pin = block.getFieldValue('vcc_pin');\n    return `import machine, time, _onewire\n\nclass OneWireError(Exception):\n    pass\n\nclass OneWire:\n    SEARCH_ROM = 0xF0\n    MATCH_ROM = 0x55\n    SKIP_ROM = 0xCC\n    def __init__(self, pin_no):\n        self.pin = machine.Pin(pin_no, machine.Pin.OPEN_DRAIN, machine.Pin.PULL_UP)\n        self.pin.value(1)\n    def set_strong_pullup(self, on):\n        if on:\n            self.pin.init(machine.Pin.OUT); self.pin.value(1)\n        else:\n            self.pin.init(machine.Pin.OPEN_DRAIN, machine.Pin.PULL_UP); self.pin.value(1)\n    def reset(self): return _onewire.reset(self.pin)\n    def write_bit(self, b): _onewire.writebit(self.pin, b)\n    def read_bit(self): return _onewire.readbit(self.pin)\n    def write_byte(self, byte): _onewire.writebyte(self.pin, byte)\n    def read_byte(self): return _onewire.readbyte(self.pin)\n    def write_bytes(self, data):\n        for b in data: _onewire.writebyte(self.pin, b)\n    def read_bytes(self, n): return bytes(_onewire.readbyte(self.pin) for _ in range(n))\n    @staticmethod\n    def crc8(data): return _onewire.crc8(bytes(data))\n    def select(self, rom):\n        self.reset(); self.write_byte(self.MATCH_ROM); self.write_bytes(rom)\n    def skip(self): self.write_byte(self.SKIP_ROM)\n    def scan(self, check_crc=True):\n        devices = []\n        rom = bytearray(8)\n        last_discrepancy = 0\n        last_device = False\n        while not last_device:\n            if not self.reset(): break\n            self.write_byte(self.SEARCH_ROM)\n            last_discrepancy, last_device = self._search_step(rom, last_discrepancy)\n            if check_crc and self.crc8(rom[:7]) != rom[7]:\n                raise OneWireError(\"crc\")\n            devices.append(bytes(rom))\n        return devices\n    def _search_step(self, rom, last_discrepancy):\n        last_zero = 0\n        bit_pos = 1\n        for byte_i in range(8):\n            for bit_i in range(8):\n                mask = 1 << bit_i\n                id_bit = self.read_bit()\n                cmp_bit = self.read_bit()\n                if id_bit and cmp_bit:\n                    raise OneWireError(\"bus\")\n                if not id_bit and not cmp_bit:\n                    if bit_pos < last_discrepancy:\n                        search_bit = 1 if (rom[byte_i] & mask) else 0\n                    elif bit_pos == last_discrepancy:\n                        search_bit = 1\n                    else:\n                        search_bit = 0\n                    if search_bit == 0: last_zero = bit_pos\n                else:\n                    search_bit = id_bit\n                if search_bit: rom[byte_i] |= mask\n                else: rom[byte_i] &= (~mask) & 0xFF\n                self.write_bit(search_bit)\n                bit_pos += 1\n        return last_zero, (last_zero == 0)\n\nclass DS18B20:\n    CONVERT_T = 0x44\n    READ_SCRATCH = 0xBE\n    READ_POWER_SUPPLY = 0xB4\n    FAMILY_CODES = (0x10, 0x28)\n    def __init__(self, pin_no):\n        self.ow = OneWire(pin_no)\n        self.roms = []\n        self._parasite = {}\n    def scan(self, check_crc=True):\n        self.roms = [r for r in self.ow.scan(check_crc=check_crc) if r[0] in self.FAMILY_CODES]\n        self._parasite = {rom: self._read_parasite_flag(rom) for rom in self.roms}\n        return self.roms\n    def is_parasite(self, rom): return self._parasite.get(rom, False)\n    def _read_parasite_flag(self, rom):\n        self.ow.select(rom); self.ow.write_byte(self.READ_POWER_SUPPLY)\n        return self.ow.read_bit() == 0\n    def convert_temp(self, rom=None, wait_ms=750):\n        if rom is None:\n            self.ow.reset(); self.ow.skip()\n            need_pullup = any(self._parasite.values())\n        else:\n            self.ow.select(rom)\n            need_pullup = self.is_parasite(rom)\n        self.ow.write_byte(self.CONVERT_T)\n        if need_pullup:\n            self.ow.set_strong_pullup(True); time.sleep_ms(wait_ms); self.ow.set_strong_pullup(False)\n        else:\n            time.sleep_ms(wait_ms)\n    def read_temp(self, rom, check_crc=True):\n        self.ow.select(rom); self.ow.write_byte(self.READ_SCRATCH)\n        data = self.ow.read_bytes(9)\n        if check_crc and self.ow.crc8(data[:8]) != data[8]:\n            raise OneWireError(\"crc\")\n        raw = (data[1] << 8) | data[0]\n        if raw & 0x8000: raw -= 0x10000\n        return raw / 2 if rom[0] == 0x10 else raw / 16\n\nds18b20_vcc = machine.Pin(${vcc_pin}, machine.Pin.OUT)\nds18b20_vcc.value(1)\nds18b20_sensor = DS18B20(${dq_pin})\nds18b20_roms = []\nds18b20_last_temp = {}\n\ndef ds18b20_scan(expected, max_tries):\n    global ds18b20_roms\n    for i in range(max_tries):\n        try:\n            r = ds18b20_sensor.scan()\n            if expected == 0 or len(r) == expected:\n                ds18b20_roms = r\n                return len(r)\n        except OneWireError:\n            pass\n        time.sleep_ms(50)\n    ds18b20_roms = []\n    return 0\n\ndef ds18b20_read(index):\n    if index >= len(ds18b20_roms):\n        return None\n    rom = ds18b20_roms[index]\n    for _ in range(5):\n        try:\n            t = ds18b20_sensor.read_temp(rom)\n            ds18b20_last_temp[rom] = t\n            return t\n        except OneWireError:\n            time.sleep_ms(20)\n    return ds18b20_last_temp.get(rom)` + \"\\n\";\n};\n\n// Block __DS18B20_scan\nvar __DS18B20_scan_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Scan\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"expected\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"expected\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"max_tries\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"max_tries\"\n        }\n    ],\n    \"colour\": \"#333333\"\n};\n\nwindow['Blockly'].Blocks['__DS18B20_scan'] = {\n    init: function() {\n        this.jsonInit(__DS18B20_scan_json);\n    }\n};\n\nwindow['Blockly'].Python['__DS18B20_scan'] = function(block) {\n    var expected = block.getFieldValue('expected');\nvar max_tries = block.getFieldValue('max_tries');\n    return [`ds18b20_scan(${expected}, ${max_tries})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n\n// Block __DS18B20_convert_temp\nvar __DS18B20_convert_temp_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Convert\"\n        }\n    ],\n    \"colour\": \"#333333\"\n};\n\nwindow['Blockly'].Blocks['__DS18B20_convert_temp'] = {\n    init: function() {\n        this.jsonInit(__DS18B20_convert_temp_json);\n    }\n};\n\nwindow['Blockly'].Python['__DS18B20_convert_temp'] = function(block) {\n        return `ds18b20_sensor.convert_temp()` + \"\\n\";\n};\n\n// Block __DS18B20_read\nvar __DS18B20_read_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Read\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"index\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"index\"\n        }\n    ],\n    \"colour\": \"#333333\"\n};\n\nwindow['Blockly'].Blocks['__DS18B20_read'] = {\n    init: function() {\n        this.jsonInit(__DS18B20_read_json);\n    }\n};\n\nwindow['Blockly'].Python['__DS18B20_read'] = function(block) {\n    var index = block.getFieldValue('index');\n    return [`ds18b20_read(${index})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n\n","code":{"init":["window['Blockly'].Python['__DS18B20_init'] = function(block) {\n    var dq_pin = block.getFieldValue('dq_pin');\nvar vcc_pin = block.getFieldValue('vcc_pin');\n    return `import machine, time, _onewire\n\nclass OneWireError(Exception):\n    pass\n\nclass OneWire:\n    SEARCH_ROM = 0xF0\n    MATCH_ROM = 0x55\n    SKIP_ROM = 0xCC\n    def __init__(self, pin_no):\n        self.pin = machine.Pin(pin_no, machine.Pin.OPEN_DRAIN, machine.Pin.PULL_UP)\n        self.pin.value(1)\n    def set_strong_pullup(self, on):\n        if on:\n            self.pin.init(machine.Pin.OUT); self.pin.value(1)\n        else:\n            self.pin.init(machine.Pin.OPEN_DRAIN, machine.Pin.PULL_UP); self.pin.value(1)\n    def reset(self): return _onewire.reset(self.pin)\n    def write_bit(self, b): _onewire.writebit(self.pin, b)\n    def read_bit(self): return _onewire.readbit(self.pin)\n    def write_byte(self, byte): _onewire.writebyte(self.pin, byte)\n    def read_byte(self): return _onewire.readbyte(self.pin)\n    def write_bytes(self, data):\n        for b in data: _onewire.writebyte(self.pin, b)\n    def read_bytes(self, n): return bytes(_onewire.readbyte(self.pin) for _ in range(n))\n    @staticmethod\n    def crc8(data): return _onewire.crc8(bytes(data))\n    def select(self, rom):\n        self.reset(); self.write_byte(self.MATCH_ROM); self.write_bytes(rom)\n    def skip(self): self.write_byte(self.SKIP_ROM)\n    def scan(self, check_crc=True):\n        devices = []\n        rom = bytearray(8)\n        last_discrepancy = 0\n        last_device = False\n        while not last_device:\n            if not self.reset(): break\n            self.write_byte(self.SEARCH_ROM)\n            last_discrepancy, last_device = self._search_step(rom, last_discrepancy)\n            if check_crc and self.crc8(rom[:7]) != rom[7]:\n                raise OneWireError(\"crc\")\n            devices.append(bytes(rom))\n        return devices\n    def _search_step(self, rom, last_discrepancy):\n        last_zero = 0\n        bit_pos = 1\n        for byte_i in range(8):\n            for bit_i in range(8):\n                mask = 1 << bit_i\n                id_bit = self.read_bit()\n                cmp_bit = self.read_bit()\n                if id_bit and cmp_bit:\n                    raise OneWireError(\"bus\")\n                if not id_bit and not cmp_bit:\n                    if bit_pos < last_discrepancy:\n                        search_bit = 1 if (rom[byte_i] & mask) else 0\n                    elif bit_pos == last_discrepancy:\n                        search_bit = 1\n                    else:\n                        search_bit = 0\n                    if search_bit == 0: last_zero = bit_pos\n                else:\n                    search_bit = id_bit\n                if search_bit: rom[byte_i] |= mask\n                else: rom[byte_i] &= (~mask) & 0xFF\n                self.write_bit(search_bit)\n                bit_pos += 1\n        return last_zero, (last_zero == 0)\n\nclass DS18B20:\n    CONVERT_T = 0x44\n    READ_SCRATCH = 0xBE\n    READ_POWER_SUPPLY = 0xB4\n    FAMILY_CODES = (0x10, 0x28)\n    def __init__(self, pin_no):\n        self.ow = OneWire(pin_no)\n        self.roms = []\n        self._parasite = {}\n    def scan(self, check_crc=True):\n        self.roms = [r for r in self.ow.scan(check_crc=check_crc) if r[0] in self.FAMILY_CODES]\n        self._parasite = {rom: self._read_parasite_flag(rom) for rom in self.roms}\n        return self.roms\n    def is_parasite(self, rom): return self._parasite.get(rom, False)\n    def _read_parasite_flag(self, rom):\n        self.ow.select(rom); self.ow.write_byte(self.READ_POWER_SUPPLY)\n        return self.ow.read_bit() == 0\n    def convert_temp(self, rom=None, wait_ms=750):\n        if rom is None:\n            self.ow.reset(); self.ow.skip()\n            need_pullup = any(self._parasite.values())\n        else:\n            self.ow.select(rom)\n            need_pullup = self.is_parasite(rom)\n        self.ow.write_byte(self.CONVERT_T)\n        if need_pullup:\n            self.ow.set_strong_pullup(True); time.sleep_ms(wait_ms); self.ow.set_strong_pullup(False)\n        else:\n            time.sleep_ms(wait_ms)\n    def read_temp(self, rom, check_crc=True):\n        self.ow.select(rom); self.ow.write_byte(self.READ_SCRATCH)\n        data = self.ow.read_bytes(9)\n        if check_crc and self.ow.crc8(data[:8]) != data[8]:\n            raise OneWireError(\"crc\")\n        raw = (data[1] << 8) | data[0]\n        if raw & 0x8000: raw -= 0x10000\n        return raw / 2 if rom[0] == 0x10 else raw / 16\n\nds18b20_vcc = machine.Pin(${vcc_pin}, machine.Pin.OUT)\nds18b20_vcc.value(1)\nds18b20_sensor = DS18B20(${dq_pin})\nds18b20_roms = []\nds18b20_last_temp = {}\n\ndef ds18b20_scan(expected, max_tries):\n    global ds18b20_roms\n    for i in range(max_tries):\n        try:\n            r = ds18b20_sensor.scan()\n            if expected == 0 or len(r) == expected:\n                ds18b20_roms = r\n                return len(r)\n        except OneWireError:\n            pass\n        time.sleep_ms(50)\n    ds18b20_roms = []\n    return 0\n\ndef ds18b20_read(index):\n    if index >= len(ds18b20_roms):\n        return None\n    rom = ds18b20_roms[index]\n    for _ in range(5):\n        try:\n            t = ds18b20_sensor.read_temp(rom)\n            ds18b20_last_temp[rom] = t\n            return t\n        except OneWireError:\n            time.sleep_ms(20)\n    return ds18b20_last_temp.get(rom)` + \"\\n\";\n};\n\n","import machine, time, _onewire\n\nclass OneWireError(Exception):\n    pass\n\nclass OneWire:\n    SEARCH_ROM = 0xF0\n    MATCH_ROM = 0x55\n    SKIP_ROM = 0xCC\n    def __init__(self, pin_no):\n        self.pin = machine.Pin(pin_no, machine.Pin.OPEN_DRAIN, machine.Pin.PULL_UP)\n        self.pin.value(1)\n    def set_strong_pullup(self, on):\n        if on:\n            self.pin.init(machine.Pin.OUT); self.pin.value(1)\n        else:\n            self.pin.init(machine.Pin.OPEN_DRAIN, machine.Pin.PULL_UP); self.pin.value(1)\n    def reset(self): return _onewire.reset(self.pin)\n    def write_bit(self, b): _onewire.writebit(self.pin, b)\n    def read_bit(self): return _onewire.readbit(self.pin)\n    def write_byte(self, byte): _onewire.writebyte(self.pin, byte)\n    def read_byte(self): return _onewire.readbyte(self.pin)\n    def write_bytes(self, data):\n        for b in data: _onewire.writebyte(self.pin, b)\n    def read_bytes(self, n): return bytes(_onewire.readbyte(self.pin) for _ in range(n))\n    @staticmethod\n    def crc8(data): return _onewire.crc8(bytes(data))\n    def select(self, rom):\n        self.reset(); self.write_byte(self.MATCH_ROM); self.write_bytes(rom)\n    def skip(self): self.write_byte(self.SKIP_ROM)\n    def scan(self, check_crc=True):\n        devices = []\n        rom = bytearray(8)\n        last_discrepancy = 0\n        last_device = False\n        while not last_device:\n            if not self.reset(): break\n            self.write_byte(self.SEARCH_ROM)\n            last_discrepancy, last_device = self._search_step(rom, last_discrepancy)\n            if check_crc and self.crc8(rom[:7]) != rom[7]:\n                raise OneWireError(\"crc\")\n            devices.append(bytes(rom))\n        return devices\n    def _search_step(self, rom, last_discrepancy):\n        last_zero = 0\n        bit_pos = 1\n        for byte_i in range(8):\n            for bit_i in range(8):\n                mask = 1 << bit_i\n                id_bit = self.read_bit()\n                cmp_bit = self.read_bit()\n                if id_bit and cmp_bit:\n                    raise OneWireError(\"bus\")\n                if not id_bit and not cmp_bit:\n                    if bit_pos < last_discrepancy:\n                        search_bit = 1 if (rom[byte_i] & mask) else 0\n                    elif bit_pos == last_discrepancy:\n                        search_bit = 1\n                    else:\n                        search_bit = 0\n                    if search_bit == 0: last_zero = bit_pos\n                else:\n                    search_bit = id_bit\n                if search_bit: rom[byte_i] |= mask\n                else: rom[byte_i] &= (~mask) & 0xFF\n                self.write_bit(search_bit)\n                bit_pos += 1\n        return last_zero, (last_zero == 0)\n\nclass DS18B20:\n    CONVERT_T = 0x44\n    READ_SCRATCH = 0xBE\n    READ_POWER_SUPPLY = 0xB4\n    FAMILY_CODES = (0x10, 0x28)\n    def __init__(self, pin_no):\n        self.ow = OneWire(pin_no)\n        self.roms = []\n        self._parasite = {}\n    def scan(self, check_crc=True):\n        self.roms = [r for r in self.ow.scan(check_crc=check_crc) if r[0] in self.FAMILY_CODES]\n        self._parasite = {rom: self._read_parasite_flag(rom) for rom in self.roms}\n        return self.roms\n    def is_parasite(self, rom): return self._parasite.get(rom, False)\n    def _read_parasite_flag(self, rom):\n        self.ow.select(rom); self.ow.write_byte(self.READ_POWER_SUPPLY)\n        return self.ow.read_bit() == 0\n    def convert_temp(self, rom=None, wait_ms=750):\n        if rom is None:\n            self.ow.reset(); self.ow.skip()\n            need_pullup = any(self._parasite.values())\n        else:\n            self.ow.select(rom)\n            need_pullup = self.is_parasite(rom)\n        self.ow.write_byte(self.CONVERT_T)\n        if need_pullup:\n            self.ow.set_strong_pullup(True); time.sleep_ms(wait_ms); self.ow.set_strong_pullup(False)\n        else:\n            time.sleep_ms(wait_ms)\n    def read_temp(self, rom, check_crc=True):\n        self.ow.select(rom); self.ow.write_byte(self.READ_SCRATCH)\n        data = self.ow.read_bytes(9)\n        if check_crc and self.ow.crc8(data[:8]) != data[8]:\n            raise OneWireError(\"crc\")\n        raw = (data[1] << 8) | data[0]\n        if raw & 0x8000: raw -= 0x10000\n        return raw / 2 if rom[0] == 0x10 else raw / 16\n\nds18b20_vcc = machine.Pin(${vcc_pin}, machine.Pin.OUT)\nds18b20_vcc.value(1)\nds18b20_sensor = DS18B20(${dq_pin})\nds18b20_roms = []\nds18b20_last_temp = {}\n\ndef ds18b20_scan(expected, max_tries):\n    global ds18b20_roms\n    for i in range(max_tries):\n        try:\n            r = ds18b20_sensor.scan()\n            if expected == 0 or len(r) == expected:\n                ds18b20_roms = r\n                return len(r)\n        except OneWireError:\n            pass\n        time.sleep_ms(50)\n    ds18b20_roms = []\n    return 0\n\ndef ds18b20_read(index):\n    if index >= len(ds18b20_roms):\n        return None\n    rom = ds18b20_roms[index]\n    for _ in range(5):\n        try:\n            t = ds18b20_sensor.read_temp(rom)\n            ds18b20_last_temp[rom] = t\n            return t\n        except OneWireError:\n            time.sleep_ms(20)\n    return ds18b20_last_temp.get(rom)"],"scan":["window['Blockly'].Python['__DS18B20_scan'] = function(block) {\n    var expected = block.getFieldValue('expected');\nvar max_tries = block.getFieldValue('max_tries');\n    return [`ds18b20_scan(${expected}, ${max_tries})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n\n","ds18b20_scan(${expected}, ${max_tries})"],"convert_temp":["window['Blockly'].Python['__DS18B20_convert_temp'] = function(block) {\n        return `ds18b20_sensor.convert_temp()` + \"\\n\";\n};\n\n","ds18b20_sensor.convert_temp()"],"read":["window['Blockly'].Python['__DS18B20_read'] = function(block) {\n    var index = block.getFieldValue('index');\n    return [`ds18b20_read(${index})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n\n","ds18b20_read(${index})"]}}